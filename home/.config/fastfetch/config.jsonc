{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "builtin",
        "source": "arch_small",
        "padding": {
            "top": 2,
            "right": 3
        },
        "color": {
            "1": "#cba6f7",
            "2": "#f5c2e7"
        }
    },
    "display": {
        "separator": "  ",
        "color": {
            "keys": "#89b4fa",
            "title": "#cba6f7",
            "output": "#cdd6f4"
        }
    },
    "modules": [
        "break",
        {
            "type": "title",
            "key": "",
            "format": "{user-name}@{host-name}"
        },
        {
            "type": "os",
            "key": " os",
            "format": "{pretty-name}",
            "keyColor": "#74c7ec"
        },
        {
            "type": "kernel",
            "key": " krnl",
            "keyColor": "#89b4fa"
        },
        {
            "type": "shell",
            "key": " sh",
            "keyColor": "#b4befe"
        },
        {
            "type": "custom",
            "format": "{#90}────────"
        },
        {
            "type": "cpu",
            "key": "󰻠 cpu",
            "format": "{name}",
            "keyColor": "#a6e3a1"
        },
        {
            "type": "memory",
            "key": " mem",
            "format": "{1} / {2} ({3})",
            "keyColor": "#94e2d5"
        },
        {
            "type": "disk",
            "key": " disk",
            "folders": "/",
            "format": "{1} / {2} ({3})",
            "keyColor": "#fab387"
        },
        {
            "type": "battery",
            "key": "󰁹 batt",
            "keyColor": "#f9e2af"
        },
        "break"
    ]
}
